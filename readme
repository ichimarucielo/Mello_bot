├── storage/                   # SQLite e artefatos persistentes
├── tests/                     # testes automatizados
├── scripts/
│   ├── setup_windows.bat
│   └── start_mello_bot.bat
├── main.py                    # utilitário de exemplo
├── requirements.txt
