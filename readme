│   ├── enums.py               # enums de domínio e status
│   ├── execution_logger.py    # persistência de execuções
│   ├── execution_repository.py# camada de armazenamento do histórico
│   ├── execution_service.py   # staging, criação e execução async
│   ├── executor.py            # execução de subprocesso do ETL
│   ├── exceptions.py          # erros de domínio
│   ├── file_manager.py        # manipulação de uploads e arquivos
│   ├── health_service.py      # diagnósticos do sistema
│   ├── history_service.py     # leitura do histórico
│   ├── identifier.py          # identificação por colunas
│   ├── manifest_generator.py  # geração e versionamento de manifestos
│   ├── manifest_loader.py     # carregamento de manifestos YAML
│   ├── models.py              # modelos Pydantic e DTOs
│   ├── orchestrator.py        # coordenação do fluxo principal
│   ├── output_validator.py    # validação de outputs esperados
│   ├── project_scaffolder.py  # scaffold de novos projetos
│   ├── registry.py            # leitura de projetos
│   ├── settings.py            # caminhos de execução
│   ├── template_engine.py     # template de projeto ETL
│   ├── upload_mapper.py       # associação entre uploads e arquivos esperados
│   ├── validator.py           # validação dos arquivos de entrada
│   └── ...
├── frontend/
