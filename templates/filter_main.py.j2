import pandas as pd
import logging
from pathlib import Path
import argparse
from typing import Union, List
from core.utils import detect_key_type, validate_key_format, standardize_column_names

logger = logging.getLogger(__name__)

def parse_args():
    parser = argparse.ArgumentParser(description="Script de filtragem de dados")
    parser.add_argument("--input", required=True, help="Arquivo de entrada")
    parser.add_argument("--output", required=True, help="Arquivo de saída")
    parser.add_argument("--condition", help="Condição de filtro (ex: valor > 100)")
    parser.add_argument("--column", help="Coluna para filtro simples")
    parser.add_argument("--values", nargs='+', help="Valores para filtro em lista")
    return parser.parse_args()

def load_data(file_path: Path) -> pd.DataFrame:
    """Carrega dados do arquivo suportando CSV e XLSX"""
    if file_path.suffix.lower() == '.csv':
        df = pd.read_csv(file_path, sep=';')
    elif file_path.suffix.lower() in ['.xlsx', '.xls']:
        df = pd.read_excel(file_path)
    else:
        raise ValueError(f"Formato não suportado: {file_path.suffix}")
    
    # Padroniza nomes de colunas
    return standardize_column_names(df)

def validate_inputs(df: pd.DataFrame, args: argparse.Namespace) -> None:
    """Valida os parâmetros de filtro"""
    if not args.condition and not args.column:
        raise ValueError("É necessário especificar --condition ou --column")
    
    if args.column and args.column not in df.columns:
        raise ValueError(f"Coluna '{args.column}' não encontrada no arquivo")
    
    if args.condition:
        # Extrai nome da coluna da condição
        import re
        column_match = re.search(r'(\w+)\s*[<>=!]', args.condition)
        if column_match:
            col = column_match.group(1)
            if col not in df.columns:
                raise ValueError(f"Coluna '{col}' não encontrada na condição")
            
            # Valida formato se for chave sensível
            key_type = detect_key_type(col)
            if key_type:
                invalid = df[~df[col].apply(lambda x: validate_key_format(str(x), key_type))]
                if not invalid.empty:
                    logger.warning(f"Coluna '{col}' tem {len(invalid)} registros com formato inválido")

def apply_filter(df: pd.DataFrame, args: argparse.Namespace) -> pd.DataFrame:
    """Aplica o filtro nos dados"""
    if args.column:
        # Filtro simples por coluna
        if args.values:
            # Filtro por lista de valores
            logger.info(f"Filtrando coluna '{args.column}' com valores: {args.values}")
            df = df[df[args.column].isin(args.values)]
        else:
            # Filtro booleano simples
            logger.info(f"Filtrando coluna '{args.column}' (valores não nulos)")
            df = df[df[args.column].notna()]
    
    elif args.condition:
        # Filtro por condição
        logger.info(f"Aplicando condição: {args.condition}")
        df = df.query(args.condition)
    
    logger.info(f"Filtro resultou em {len(df)} registros")
    return df

def main():
    args = parse_args()
    
    try:
        # Carrega dados
        logger.info(f"Carregando arquivo: {args.input}")
        df = load_data(Path(args.input))
        
        # Valida inputs
        validate_inputs(df, args)
        
        # Aplica filtro
        result = apply_filter(df, args)
        
        # Salva resultado
        output_path = Path(args.output)
        logger.info(f"Salvando resultado em: {output_path}")
        
        if output_path.suffix.lower() == '.csv':
            result.to_csv(output_path, index=False, sep=';')
        else:
            result.to_excel(output_path, index=False)
            
        logger.info("Filtragem concluída com sucesso!")
        
    except Exception as e:
        logger.error(f"Erro na filtragem: {str(e)}")
        raise

if __name__ == "__main__":
    main()
